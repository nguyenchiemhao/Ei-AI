# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-esm/
/build/
.next/
*.tsbuildinfo

# Environment — never commit a secret
.env
.env.*
!.env.example

# Python (parser worker)
__pycache__/
*.py[cod]
.venv/
venv/

# Model weights and local data
# Anchored, not bare: git matches a bare `models/` or `storage/` at any depth, and `storage/`
# swallowed apps/api/src/adapters/storage/ — the only implementation of StoragePort — so the
# repository could not be built from a clone. A leading slash keeps each pattern to the root.
/models/
*.gguf
*.safetensors
/storage/
/uploads/

# Logs and caches
*.log
npm-debug.log*
.cache/
coverage/
.eslintcache

# IDE
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini
spike/out/
spike/corpus/
