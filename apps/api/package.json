{
  "name": "@ei-ai/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:worker": "node dist/worker.main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/database/migrate.js",
    "migrate:fresh": "node dist/database/migrate.js --fresh",
    "seed": "node dist/database/seed.js",
    "codegen": "kysely-codegen --dialect postgres --url $DATABASE_URL --out-file src/database/schema.ts --camel-case false",
    "migrate:verify": "node dist/database/migrate.js --verify",
    "test:coverage": "vitest run --coverage",
    "arch:chunks": "eslint --no-config-lookup --config eslint.architecture.config.mjs src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.5",
    "@nestjs/core": "11.0.5",
    "@nestjs/platform-express": "11.0.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1",
    "pg": "8.13.1",
    "kysely": "0.27.5",
    "@node-rs/argon2": "2.2.1",
    "@nestjs/jwt": "12.0.2",
    "ioredis": "6.0.0",
    "cookie-parser": "1.4.7",
    "@nestjs/swagger": "11.4.7",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@ei-ai/eslint-config": "workspace:*",
    "@ei-ai/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "11.0.0",
    "@types/node": "22.10.7",
    "eslint": "9.18.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "@types/pg": "8.11.10",
    "kysely-codegen": "0.17.0",
    "@vitest/coverage-v8": "2.1.8",
    "@types/cookie-parser": "1.4.9"
  }
}
