{
  "name": "@ei-ai/shared-types",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist-esm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@ei-ai/eslint-config": "workspace:*",
    "@ei-ai/tsconfig": "workspace:*",
    "eslint": "9.18.0",
    "typescript": "5.7.3"
  },
  "module": "dist-esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
